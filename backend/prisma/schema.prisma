generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  wallet         Wallet?
  orders         Order[]
  trades         Trade[]
  positions      Position[]
  replaySessions ReplaySession[]
}

model Wallet {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  cash   Decimal @default(1000000) @db.Decimal(18, 2)

  user User @relation(fields: [userId], references: [id])
}

model Candle {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String   @default("1D")
  date      DateTime
  open      Decimal  @db.Decimal(18, 4)
  high      Decimal  @db.Decimal(18, 4)
  low       Decimal  @db.Decimal(18, 4)
  close     Decimal  @db.Decimal(18, 4)
  volume    BigInt

  @@unique([symbol, timeframe, date])
  @@index([symbol, timeframe, date])
}

model ReplaySession {
  id          Int      @id @default(autoincrement())
  userId      Int
  symbol      String
  startDate   DateTime
  currentDate DateTime
  cash        Decimal  @default(1000000) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  orders    Order[]
  trades    Trade[]
  positions Position[]
}

model Position {
  id              Int     @id @default(autoincrement())
  userId          Int
  replaySessionId Int?
  symbol          String
  quantity        Int
  avgCost         Decimal @db.Decimal(18, 4)

  user          User           @relation(fields: [userId], references: [id])
  replaySession ReplaySession? @relation(fields: [replaySessionId], references: [id])

  @@index([userId, symbol])
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  replaySessionId Int?
  symbol          String
  side            OrderSide
  type            OrderType   @default(MARKET)
  quantity        Int
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  user          User           @relation(fields: [userId], references: [id])
  replaySession ReplaySession? @relation(fields: [replaySessionId], references: [id])
  trade         Trade?
}

model Trade {
  id              Int       @id @default(autoincrement())
  userId          Int
  orderId         Int       @unique
  replaySessionId Int?
  symbol          String
  side            OrderSide
  quantity        Int
  price           Decimal   @db.Decimal(18, 4)
  realizedPnl     Decimal?  @db.Decimal(18, 2)
  executedAt      DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id])
  replaySession ReplaySession? @relation(fields: [replaySessionId], references: [id])
}
