# Database (Neon PostgreSQL)
# Pooled connection URL (used by the application runtime)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/tradewise?sslmode=require"
# Direct / unpooled connection URL (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-xyz.region.neon.tech/tradewise?sslmode=require"

# Server & CORS
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://tradewise-frontend.onrender.com"

# Authentication
JWT_SECRET="your-secure-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN=7d

# Market Data Providers (Optional - Twelve Data falls back to Yahoo Finance if omitted)
TWELVE_DATA_API_KEY="your-twelve-data-api-key"
STOCK_EXCHANGE=NASDAQ
